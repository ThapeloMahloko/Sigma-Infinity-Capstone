{
  "name": "Smart Farm Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#071411",
    "editor.foreground": "#ffffff",
    "sideBar.background": "#0b1f1a",
    "activityBar.background": "#0b1f1a",
    "panel.background": "#0c1f1a",
    "terminal.background": "#0c1f1a",
    "tab.activeBackground": "#0c1f1a",
    "tab.inactiveBackground": "#0b1f1a",
    "tab.inactiveForeground": "#8fb8aa",
    "statusBar.background": "#071411",
    "titleBar.activeBackground": "#0b1f1a",
    "input.background": "#0c1f1a",
    "input.border": "#16352d",
    "list.activeSelectionBackground": "#0d2f25",
    "list.hoverBackground": "#0d2f25",
    "editor.selectionBackground": "#16352d",
    "editor.lineHighlightBackground": "#0c1f1a",
    "editorGroupHeader.tabsBackground": "#0b1f1a",
    "badge.background": "#16352d",
    "badge.foreground": "#8fb8aa",
    "widget.border": "#ffffff0f",
    "panel.border": "#16352d",
    "sideBar.border": "#16352d",
    "editorGroup.border": "#16352d",
    "focusBorder": "#16352d"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8fb8aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b8d1c8"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8fb8aa"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other"
      ],
      "settings": {
        "foreground": "#b8d1c8"
      }
    },
    {
      "name": "Numbers/Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#8fb8aa"
      }
    },
    {
      "name": "Types/Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#b8d1c8"
      }
    }
  ]
}
